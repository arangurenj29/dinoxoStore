---
import { whatsappHref } from '../content/contact';
import { socialLinks } from '../content/social';
import ButtonLink from './core/ButtonLink.astro';
import Icon from './core/Icon.astro';
import Logo from './core/Logo.astro';

interface Props {
  homeHref?: string;
  linkPrefix?: string;
}

const { homeHref = '#inicio', linkPrefix = '' } = Astro.props;
---

<header class="site-header" data-site-header>
  <nav class="site-nav" aria-label="Navegación principal">
    <a class="site-wordmark" href={homeHref} aria-label="Dinoxo Store, inicio">
      <Logo className="site-wordmark__logo" />
      <span>dinoxo.store</span>
    </a>
    <div class="site-nav__actions">
      <div class="site-social-links" role="group" aria-label="Redes oficiales">
        <a class="social-link" href="/juegos/" aria-label="Juega" title="Juega">
          <Icon name="control" alt="" />
        </a>
        <a
          class="social-link"
          href={`${linkPrefix}#productos`}
          aria-label="Productos"
          title="Productos"
        >
          <Icon name="book" alt="" />
        </a>
        <a
          class="social-link"
          href={`${linkPrefix}#como-funciona`}
          aria-label="Cómo funciona"
          title="Cómo funciona"
        >
          <Icon name="help" alt="" />
        </a>
        {
          socialLinks.map((socialLink) => (
            <a
              class="social-link"
              href={socialLink.href}
              target="_blank"
              rel="noreferrer"
              aria-label={socialLink.label}
              title={socialLink.label}
            >
              <Icon name={socialLink.icon} alt="" />
            </a>
          ))
        }
      </div>
      <ButtonLink href={whatsappHref} label="Hablar ahora" variant="secondary">
        <Icon slot="icon" name="whatsapp-contact" alt="" />
      </ButtonLink>
    </div>
  </nav>
</header>
