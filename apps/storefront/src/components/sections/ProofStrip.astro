---
import Icon from '../core/Icon.astro';
---

<section id="prueba" class="proof-strip" aria-label="Información clave">
  <div class="proof-strip__inner">
    <div class="proof-item" data-reveal="proof" style="--reveal-delay: 40ms">
      <Icon name="gift-card" alt="" />
      <div>
        <strong>Contenido digital</strong>
        <span>Consulta opciones antes de confirmar.</span>
      </div>
    </div>
    <div class="proof-item" data-reveal="proof" style="--reveal-delay: 120ms">
      <Icon name="whatsapp-contact" alt="" />
      <div>
        <strong>Atención directa</strong>
        <span>Coordinación por WhatsApp.</span>
      </div>
    </div>
    <div class="proof-item" data-reveal="proof" style="--reveal-delay: 200ms">
      <Icon name="region" alt="" />
      <div>
        <strong>Región clara</strong>
        <span>Se confirma antes de tu compra.</span>
      </div>
    </div>
  </div>
</section>
