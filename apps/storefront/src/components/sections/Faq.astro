---
import SectionHeading from '../SectionHeading.astro';

const entries = [
  {
    question: '¿Cómo sé si un producto está disponible?',
    answer:
      'Escríbenos por WhatsApp. Antes de confirmar, revisamos la disponibilidad y condiciones del producto.',
  },
  {
    question: '¿Los productos mostrados ya están a la venta?',
    answer:
      'Los productos publicados son totalmente nuevos y son de Región Americana.  consulta disponibilidad.',
  },
  {
    question: 'Que métodos de pago aceptamos',
    answer:
      'Aceptamos pagos por usdt tanto por binance o por alguna wallet tambien aceptamos pagos en bolivares venezolanos',
  },
] as const;
---

<section
  id="preguntas"
  class="site-section faq-section"
  aria-labelledby="faq-title"
>
  <div class="site-section__inner faq-layout">
    <SectionHeading
      eyebrow="Preguntas frecuentes"
      headingId="faq-title"
      title="Respuestas antes de que las necesites."
    />
    <div class="faq-list">
      {
        entries.map((entry, index) => (
          <details data-reveal="faq" style={`--reveal-delay: ${index * 70}ms`}>
            <summary>{entry.question}</summary>
            <p>{entry.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
