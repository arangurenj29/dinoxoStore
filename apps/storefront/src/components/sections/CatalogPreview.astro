---
import { demoProducts, productWhatsAppHref } from '../../content/catalog';
import ButtonLink from '../core/ButtonLink.astro';
import Icon from '../core/Icon.astro';
import SectionHeading from '../SectionHeading.astro';
---

<section
  id="productos"
  class="site-section catalog-section"
  aria-labelledby="catalog-title"
>
  <div class="site-section__inner">
    <SectionHeading
      eyebrow="Vista previa"
      headingId="catalog-title"
      title="El catálogo se administra desde un solo lugar."
      description="Estas tarjetas son una demostración: el administrador reemplazará plataforma, región, precio y disponibilidad."
    />
    <div class="catalog-grid">
      {
        demoProducts.map((product) => (
          <article class="catalog-card">
            <p class="catalog-card__status">Producto de demostración</p>
            <h3>{product.platform}</h3>
            <dl>
              <div>
                <dt>Valor</dt>
                <dd>{product.denomination}</dd>
              </div>
              <div>
                <dt>Región</dt>
                <dd>{product.region}</dd>
              </div>
              <div>
                <dt>Entrega</dt>
                <dd>{product.delivery}</dd>
              </div>
            </dl>
            <ButtonLink
              href={productWhatsAppHref(product)}
              label="Consultar producto"
              variant="secondary"
            >
              <Icon slot="icon" name="whatsapp-contact" alt="" />
            </ButtonLink>
          </article>
        ))
      }
    </div>
  </div>
</section>
