---
import SectionHeading from '../SectionHeading.astro';

const steps = [
  {
    mascot: '/brand/mascot/nox-runner-v1.png',
    pose: 'step-mascot--choose',
    title: 'Elige',
    description: 'Revisa la plataforma, región y denominación que necesitas.',
  },
  {
    mascot: '/brand/mascot/nox-runner-stride-v1.png',
    pose: 'step-mascot--confirm',
    title: 'Confirma',
    description: 'Escríbenos para confirmar disponibilidad y condiciones.',
  },
  {
    mascot: '/brand/mascot/nox-runner-jump-v1.png',
    pose: 'step-mascot--receive',
    title: 'Recibe',
    description: 'Coordinamos la entrega digital después de tu confirmación.',
  },
] as const;
---

<section
  id="como-funciona"
  class="site-section how-it-works"
  aria-labelledby="how-title"
>
  <div class="site-section__inner">
    <SectionHeading
      eyebrow="Proceso simple"
      headingId="how-title"
      title="Tres pasos, información clara."
      description="Sin procesos ocultos: primero confirmamos los datos que importan para tu compra."
    />
    <ol class="step-list">
      {
        steps.map((step, index) => (
          <li
            class="step-item"
            data-reveal="step"
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <figure class={`step-mascot ${step.pose}`} aria-hidden="true">
              <span class="step-mascot__number">0{index + 1}</span>
              <img src={step.mascot} alt="" width="1254" height="1254" />
            </figure>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
