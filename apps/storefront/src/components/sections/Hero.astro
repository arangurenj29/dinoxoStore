---
import { whatsappHref } from '../../content/contact';
import ButtonLink from '../core/ButtonLink.astro';
import Icon from '../core/Icon.astro';
import Logo from '../core/Logo.astro';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <picture class="hero-background" aria-hidden="true">
    <source
      type="image/avif"
      srcset="/brand/dinoxostore-hero-768.avif 768w, /brand/dinoxostore-hero-1440.avif 1440w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/brand/dinoxostore-hero-768.webp 768w, /brand/dinoxostore-hero-1440.webp 1440w"
      sizes="100vw"
    />
    <img
      src="/brand/dinoxostore-hero-1440.webp"
      width="1440"
      height="810"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="hero-content">
    <Logo className="hero-logo" />
    <p class="hero-kicker">Contenido digital · atención directa</p>
    <h1 id="hero-title">Tu recarga,<br />rápida y segura</h1>
    <p class="hero-copy">
      Solo funciona para cuentas Americanas.
    </p>
    <div class="hero-actions">
      <ButtonLink href={whatsappHref} label="Escríbenos por WhatsApp">
        <Icon slot="icon" name="whatsapp-contact" alt="" />
      </ButtonLink>
    </div>
  </div>
  <a
    class="hero-scroll-cue"
    href="#como-funciona"
    aria-label="Explorar la página"
  >
    <span>Explorar</span>
    <i aria-hidden="true"></i>
  </a>
</section>
