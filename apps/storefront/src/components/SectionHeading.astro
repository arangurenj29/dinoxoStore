---
interface Props {
  description?: string;
  eyebrow: string;
  headingId: string;
  title: string;
}

const { description, eyebrow, headingId, title } = Astro.props;
---

<div class="section-heading" data-reveal="heading">
  <p class="section-eyebrow">{eyebrow}</p>
  <h2 id={headingId}>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</div>
