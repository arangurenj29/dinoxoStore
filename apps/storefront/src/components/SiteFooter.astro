---
import { socialLinks } from '../content/social';
import Icon from './core/Icon.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>Dinoxo Store</p>
    <nav aria-label="Redes oficiales">
      {
        socialLinks.map((socialLink) => (
          <a
            class="social-link"
            href={socialLink.href}
            target="_blank"
            rel="noreferrer"
            aria-label={socialLink.label}
            title={socialLink.label}
          >
            <Icon name={socialLink.icon} alt="" />
          </a>
        ))
      }
    </nav>
    <small
      >El catálogo, la disponibilidad y las condiciones se confirmarán antes de
      cada compra.</small
    >
  </div>
</footer>
