---
import { resolvePageMetadata, type PageKind } from '../lib/site-metadata';
import '../styles/global.css';

interface Props {
  description?: string;
  pageKind?: PageKind;
  title?: string;
}

const {
  description: descriptionOverride,
  pageKind = 'default',
  title: titleOverride,
} = Astro.props;
const metadata = resolvePageMetadata(
  import.meta.env.PUBLIC_DEPLOY_ENV,
  pageKind,
);
const description = descriptionOverride ?? metadata.description;
const title = titleOverride ?? metadata.title;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={metadata.robots} />
    <link
      rel="icon"
      type="image/webp"
      href="/brand/dinoxostore-logo-isolated-v1-320.webp"
    />
    {
      metadata.canonicalUrl && (
        <link rel="canonical" href={metadata.canonicalUrl} />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
