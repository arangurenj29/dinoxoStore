---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="dinoxoArcade | Dinoxo Store"
  description="dinoxoArcade: minijuegos originales para divertirte sin registro."
  canonicalUrl="https://dinoxostore.com/juegos/"
>
  <SiteHeader homeHref="/" linkPrefix="/" showGameLink={false} />
  <main class="arcade-page">
    <section class="arcade-hero" aria-labelledby="arcade-title">
      <div class="arcade-hero__grid" aria-hidden="true"></div>
      <div class="arcade-hero__content">
        <p class="game-intro__eyebrow">dinoxoArcade</p>
        <h1 id="arcade-title">Un descanso para jugar.</h1>
        <p>
          Minijuegos rápidos, una misión simple: sumar puntos y pasarla bien.
          No pedimos ni almacenamos tus datos.
        </p>
        <a class="game-intro__jump" href="#seleccion">Elegir juego</a>
      </div>
      <div class="arcade-hero__mascot-wrap" aria-hidden="true">
        <span class="arcade-hero__ring arcade-hero__ring--outer"></span>
        <span class="arcade-hero__ring arcade-hero__ring--inner"></span>
        <img
          class="arcade-hero__mascot"
          src="/brand/mascot/nox-runner-v1.png"
          alt=""
          width="1254"
          height="1254"
        />
      </div>
    </section>

    <section
      class="game-selector"
      id="seleccion"
      aria-labelledby="selector-title"
    >
      <div class="game-selector__heading">
        <div>
          <p class="game-intro__eyebrow">Seleccioná tu modo</p>
          <h2 id="selector-title">Diviertete con Nox y sus aventuras</h2>
        </div>
      </div>

      <div class="game-selector__grid">
        <article class="game-card game-card--rush game-card--featured">
          <div
            class="game-card__visual game-card__visual--rush"
            aria-hidden="true"
          >
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="game-card__content">
            <p class="game-card__number">01 · Precisión</p>
            <h3>Nox Nucleo</h3>
            <p>Capturá núcleos de energía azul durante treinta segundos.</p>
            <a class="game-card__link" href="/juegos/dino-rush/"
              >Jugar Nox Nucleo <span aria-hidden="true">↗</span></a
            >
          </div>
        </article>

        <article class="game-card game-card--runner">
          <div
            class="game-card__visual game-card__visual--runner"
            aria-hidden="true"
          >
            <span class="game-card__runner-line"></span>
            <span class="game-card__runner-line game-card__runner-line--short"
            ></span>
            <img
              class="game-card__runner-frame game-card__runner-frame--1"
              src="/brand/mascot/nox-run-cycle-1-v1.png"
              alt=""
              width="1254"
              height="1254"
            />
            <img
              class="game-card__runner-frame game-card__runner-frame--2"
              src="/brand/mascot/nox-run-cycle-opposite-v4.png"
              alt=""
              width="1254"
              height="1254"
            />
          </div>
          <div class="game-card__content">
            <p class="game-card__number">02 · Reflejos</p>
            <h3>Nox Runner</h3>
            <p>Saltá los glitches del camino y acumulá puntos junto a Nox.</p>
            <a class="game-card__link" href="/juegos/nox-runner/"
              >Jugar Nox Runner <span aria-hidden="true">↗</span></a
            >
          </div>
        </article>

        <article class="game-card game-card--eat">
          <div
            class="game-card__visual game-card__visual--eat"
            aria-hidden="true"
          >
            <img
              class="game-card__eat-head"
              src="/brand/mascot/nox-eat-head-v1.png"
              alt=""
              width="600"
              height="428"
            />
            <img
              class="game-card__eat-card game-card__eat-card--ps"
              src="/brand/giftcards/playstation.png"
              alt=""
              width="213"
              height="156"
            />
            <img
              class="game-card__eat-card game-card__eat-card--nx"
              src="/brand/giftcards/nintendo.png"
              alt=""
              width="289"
              height="334"
            />
            <img
              class="game-card__eat-card game-card__eat-card--xb"
              src="/brand/giftcards/xbox.png"
              alt=""
              width="205"
              height="282"
            />
          </div>
          <div class="game-card__content">
            <p class="game-card__number">03 · Laberinto</p>
            <h3>Nox Eat</h3>
            <p>
              Comé los puntos y atrapá las gift cards de PlayStation, Nintendo
              y Xbox.
            </p>
            <a class="game-card__link" href="/juegos/nox-eat/"
              >Jugar Nox Eat <span aria-hidden="true">↗</span></a
            >
          </div>
        </article>

        <article class="game-card game-card--nox">
          <div
            class="game-card__visual game-card__visual--nox"
            aria-hidden="true"
          >
            <span class="game-card__nox-door"></span>
            <span class="game-card__nox-glow"></span>
          </div>
          <div class="game-card__content">
            <p class="game-card__number">04 · Aventura</p>
            <h3>Nox</h3>
            <p>La zona de Nox ya está lista. El juego aterriza pronto.</p>
            <a class="game-card__link" href="/juegos/nox/"
              >Conocer la zona <span aria-hidden="true">↗</span></a
            >
          </div>
        </article>
      </div>
    </section>

    <section class="game-note arcade-note" aria-label="Nota de privacidad">
      <p>
        dinoxoArcade es solo para divertirte. Tus partidas no se guardan y
        no solicitamos información personal.
      </p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
