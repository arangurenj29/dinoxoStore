---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <header>
    <a class="brand" href="/" aria-label="Dinoxo Store, inicio">Dinoxo Store</a>
  </header>

  <main>
    <section aria-labelledby="foundation-title">
      <p class="eyebrow">Tienda gamer independiente</p>
      <h1 id="foundation-title">Dinoxo Store</h1>
      <p>
        Estamos preparando una experiencia clara para elegir contenido digital y
        recibir atención directa.
      </p>
    </section>
  </main>

  <footer>
    <small>&copy; {new Date().getFullYear()} Dinoxo Store</small>
  </footer>
</BaseLayout>
