{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinoxostore-storefront",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "vars": {
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5Osn2s-bQqLKeGm0BZ5ayA_Efh7gLjP",
    "SUPABASE_URL": "https://yvbrvclbqmvxxtfehxxp.supabase.co",
  },
  "routes": [
    {
      "pattern": "dinoxostore.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
}
