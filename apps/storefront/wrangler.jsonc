{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinoxostore-storefront",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dinoxostore.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
