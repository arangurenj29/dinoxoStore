# Preview/local overrides are mandatory and must target an isolated non-production
# Supabase project. Build validation rejects partial, invalid or production values.
# These are public; PostgreSQL RLS still enforces access.
PUBLIC_SUPABASE_URL=https://your-isolated-preview-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_preview_key
